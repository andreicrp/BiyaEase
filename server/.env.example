# Application Environment
NODE_ENV=development
PORT=5000

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8081

# PostgreSQL + PostGIS Database URL
# Local Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biyaease
#
# Railway Cloud Example (Internal or Public TCP Proxy):
# DATABASE_URL=postgresql://postgres:PASSWORD@junction.proxy.rlwy.net:54321/railway?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biyaease

# Authentication & Maps Keys (Future Phases)
JWT_SECRET=your-256-bit-secret-placeholder-change-in-production
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_placeholder
GOOGLE_PLACES_API_KEY=your_google_places_api_key_placeholder
