{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "react-native-fix.d.ts",
    "react-native-jsx.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
