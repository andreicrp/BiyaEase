# ==============================================================================
# BiyaEase Environment Variables Template
# Copy this file to .env and configure your local settings.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# CORS Configuration (comma-separated allowed origins for development)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8081

# PostgreSQL + PostGIS Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biyaease_dev

# Authentication & Security (Future Phases)
JWT_SECRET=your-256-bit-secret-placeholder-change-in-production

# External Map & Location APIs (Future Phases)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_placeholder
GOOGLE_PLACES_API_KEY=your_google_places_api_key_placeholder
